      "before": "namespace doc_recursive {\n",
      "after": "\n}\nint main() { int value = 0; const std::string text = \"(123)\"; require(parse(doc_recursive::r_expression<int>(value), text).matched); require(value == 123); }\n",
      "run": true,
      "replacements": [
        {
          "old": "struct r_group_t\n{\n    // skipped ...",
          "new": "struct r_group_t\n{\n    T& value_;\n    explicit r_group_t(T& value) : value_(value) {}",
          "count": 1,
          "reason": "Supply the explicitly omitted stored value and constructor."
        },
        {
          "old": "struct r_factor_t\n{\n    // skipped ...",
          "new": "struct r_factor_t\n{\n    T& value_;\n    explicit r_factor_t(T& value) : value_(value) {}",
          "count": 1,
          "reason": "Supply the explicitly omitted stored value and constructor."
        },
        {
          "old": "struct r_term_t\n{\n    // skipped ...",
          "new": "struct r_term_t\n{\n    T& value_;\n    explicit r_term_t(T& value) : value_(value) {}",
          "count": 1,
          "reason": "Supply the explicitly omitted stored value and constructor."
        },
        {
          "old": "struct r_expression\n{\n    // skipped ...",
          "new": "struct r_expression\n{\n    T& value_;\n    explicit r_expression(T& value) : value_(value) {}",
          "count": 1,
          "reason": "Supply the explicitly omitted stored value and constructor."
        },
        {
          "old": "& // skipped \u2026\n        )",
          "new": "& axe::r_empty()",
          "count": 1,
          "reason": "Complete the omitted factor continuation with the empty rule, consuming the unmatched parenthesis."
        },
        {
          "old": "& // skipped ...\n        )",
          "new": "& axe::r_empty())",
          "count": 1,
          "reason": "Complete the omitted term continuation with the empty rule."
        }
      ]
